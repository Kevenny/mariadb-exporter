{
  "title": "MariaDB — Replicação",
  "uid": "mariadb-replication",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["mariadb", "replication"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\"}, environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\", environment=~\"$environment\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "connection_name",
        "label": "Conexão (multi-source)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}, connection_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Réplicas saudáveis",
      "description": "Conexões de replicação com as duas threads (IO e SQL) rodando.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 1 and on(service_name, connection_name) mariadb_slave_io_running == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Réplicas com thread parada",
      "description": "Qualquer thread (IO ou SQL) parada interrompe a replicação.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count((mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 0) or (mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 0)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Atraso máximo (s)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max(mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Réplicas com erro",
      "description": "last_errno diferente de zero indica que a replicação parou por erro de aplicação de evento.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} != 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Estado das conexões de replicação",
      "description": "Uma linha por conexão. O MariaDB suporta multi-source: connection_name vazio é a conexão default.",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "SQL"
        },
        {
          "expr": "mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "IO"
        },
        {
          "expr": "mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "LAG"
        },
        {
          "expr": "mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "ERR"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "Value #SQL": "SQL thread",
              "Value #IO": "IO thread",
              "Value #LAG": "Atraso (s)",
              "Value #ERR": "Último erro"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SQL thread" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "PARADA", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "IO thread" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "PARADA", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Atraso de replicação por conexão",
      "description": "Seconds_Behind_Master. A métrica é omitida quando a replicação está parada (o servidor devolve NULL), então uma lacuna no gráfico também é sinal de problema.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} ← {{master_host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Threads de replicação (0 = parada, 1 = rodando)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} SQL",
          "refId": "A"
        },
        {
          "expr": "mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} IO",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 8,
      "title": "Progresso do relay log",
      "description": "Posição no relay log. Uma linha achatada com atraso crescente indica thread SQL travada.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_relay_log_pos{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Taxa de avanço do relay log",
      "description": "Derivada da posição: zero enquanto há atraso significa replicação estagnada.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_slave_relay_log_pos{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}[5m])",
          "legendFormat": "{{service_name}} / {{connection_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 10,
      "title": "Códigos de erro por conexão",
      "type": "table",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} != 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "Value": "Errno" }
          }
        }
      ]
    }
  ]
}
