{
  "title": "MariaDB — Replication",
  "uid": "mariadb-replication",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["mariadb", "replication"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\"}, environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\", environment=~\"$environment\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "connection_name",
        "label": "Connection (multi-source)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}, connection_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Healthy replicas",
      "description": "Replication connections with both threads (IO and SQL) running.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 1 and on(service_name, connection_name) mariadb_slave_io_running == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Replicas with a stopped thread",
      "description": "Any thread (IO or SQL) stopped interrupts replication.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count((mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 0) or (mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} == 0)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Maximum lag (s)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max(mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Replicas with error",
      "description": "A non-zero last_errno indicates replication stopped due to an event application error.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} != 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Replication connection state",
      "description": "One row per connection. MariaDB supports multi-source: an empty connection_name is the default connection.",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "SQL"
        },
        {
          "expr": "mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "IO"
        },
        {
          "expr": "mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "LAG"
        },
        {
          "expr": "mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "format": "table",
          "instant": true,
          "refId": "ERR"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "Value #SQL": "SQL thread",
              "Value #IO": "IO thread",
              "Value #LAG": "Lag (s)",
              "Value #ERR": "Last error"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SQL thread" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "STOPPED", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "IO thread" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "STOPPED", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Replication lag by connection",
      "description": "Seconds_Behind_Master. The metric is omitted when replication is stopped (the server returns NULL), so a gap in the graph is also a sign of trouble.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_seconds_behind_master{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} ← {{master_host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Replication threads (0 = stopped, 1 = running)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_sql_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} SQL",
          "refId": "A"
        },
        {
          "expr": "mariadb_slave_io_running{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}} IO",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 8,
      "title": "Relay log progress",
      "description": "Position in the relay log. A flat line with growing lag indicates a stuck SQL thread.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_relay_log_pos{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}",
          "legendFormat": "{{service_name}} / {{connection_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Relay log advance rate",
      "description": "Derivative of the position: zero while there's lag means replication is stalled.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_slave_relay_log_pos{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"}[5m])",
          "legendFormat": "{{service_name}} / {{connection_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 10,
      "title": "Error codes by connection",
      "type": "table",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_slave_last_errno{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", connection_name=~\"$connection_name\"} != 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "Value": "Errno" }
          }
        }
      ]
    }
  ]
}
