{
  "title": "MariaDB — Users & Access",
  "uid": "mariadb-users-access",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["mariadb", "userstat", "security"],
  "time": { "from": "now-1h", "to": "now" },
  "description": "Requires userstat=ON (SET GLOBAL userstat = ON). Without it, the userstat and clientstat collectors expose zero metrics.",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\"}, environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_up{cluster=~\"$cluster\", environment=~\"$environment\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "user",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_user_total_connections_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}, user)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Security and Connectivity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "userstat enabled?",
      "description": "Without userstat=ON, per-user/table/index metrics don't exist.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_userstat_enabled{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OFF", "color": "red", "index": 0 },
                "1": { "text": "ON", "color": "green", "index": 1 }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Access denied",
      "description": "Rejected access attempts by user. A spike may indicate an expired credential in an application — or a brute-force attempt.",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_user_access_denied_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]) > 0",
          "legendFormat": "{{service_name}} / {{user}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "title": "Aborted connections (server)",
      "description": "aborted_connects are attempts that failed authentication/handshake; aborted_clients are clients that disappeared without closing the connection.",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_aborted_connects_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}[5m])",
          "legendFormat": "{{service_name}} connects",
          "refId": "A"
        },
        {
          "expr": "rate(mariadb_aborted_clients_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}[5m])",
          "legendFormat": "{{service_name}} clients",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "row",
      "title": "Connections",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "title": "max_connections usage (%)",
      "description": "Getting close to max_connections causes a 'Too many connections' error. Consider pooling in the application before raising the limit.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "(sum by (service_name) (mariadb_user_concurrent_connections{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}) / on(service_name) clamp_min(mariadb_max_connections{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}, 1)) * 100",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Concurrent connections by user",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_user_concurrent_connections{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}",
          "legendFormat": "{{service_name}} / {{user}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 6,
      "title": "New connections by user",
      "description": "A high rate with few concurrent connections indicates the absence of pooling: the application opens and closes a connection for every operation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_user_total_connections_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m])",
          "legendFormat": "{{service_name}} / {{user}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "title": "Lost connections by user",
      "description": "Connections terminated abnormally — network timeout, wait_timeout, or a dead client process.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_user_lost_connections_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]) > 0",
          "legendFormat": "{{service_name}} / {{user}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "row",
      "title": "Load Profile by User",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Commands by user (SELECT / UPDATE / other)",
      "description": "Shows each user's profile: read, write, or administrative.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_user_select_commands_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m])",
          "legendFormat": "{{user}} SELECT",
          "refId": "A"
        },
        {
          "expr": "rate(mariadb_user_update_commands_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m])",
          "legendFormat": "{{user}} UPDATE",
          "refId": "B"
        },
        {
          "expr": "rate(mariadb_user_other_commands_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m])",
          "legendFormat": "{{user}} other",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 9,
      "title": "Read efficiency by user",
      "description": "rows_read far above rows_sent means the server scans many rows to return few — typical of a missing index.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_user_rows_read_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]) / clamp_min(rate(mariadb_user_rows_sent_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]), 0.001)",
          "legendFormat": "{{user}} read/sent",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Top 10 users by rows read",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(10, rate(mariadb_user_rows_read_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "Value": "Rows read/s" }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Top 10 users by rows changed",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(10, rate(mariadb_user_rows_changed_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\", user=~\"$user\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "Value": "Rows changed/s" }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "By Origin (clientstat)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "title": "Connections by source host",
      "description": "From CLIENT_STATISTICS: groups by the IP/host the connection came from, regardless of user.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_client_total_connections_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}[5m])",
          "legendFormat": "{{service_name}} / {{client}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 13,
      "title": "Row traffic by source host",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(mariadb_client_rows_read_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}[5m])",
          "legendFormat": "{{client}} read/s",
          "refId": "A"
        },
        {
          "expr": "rate(mariadb_client_rows_sent_total{cluster=~\"$cluster\", environment=~\"$environment\", service_name=~\"$service_name\"}[5m])",
          "legendFormat": "{{client}} sent/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}
