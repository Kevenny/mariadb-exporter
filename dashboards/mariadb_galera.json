{
  "title": "MariaDB — Galera Cluster",
  "uid": "mariadb-galera",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["mariadb", "galera", "cluster"],
  "time": { "from": "now-1h", "to": "now" },
  "description": "Requires the galera collector enabled (--collector.galera, opt-in) and wsrep active on the instance.",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "cluster_name",
        "label": "Galera cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_galera_cluster_size, cluster_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(mariadb_galera_cluster_size{cluster_name=~\"$cluster_name\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Galera collector available?",
      "description": "0 means wsrep is not active on this instance, or --collector.galera was not enabled (the collector is opt-in).",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_collector_available{collector=\"galera\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "UNAVAILABLE", "color": "text", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Cluster size",
      "description": "Number of nodes that make up the current component. A drop indicates a node leaving or a network partition.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max by (cluster_name) (mariadb_galera_cluster_size{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"})",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Component status",
      "description": "Primary = the component has quorum and accepts writes. non-Primary = lost quorum (split-brain avoided) and rejects writes.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_cluster_status{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "non-Primary", "color": "red", "index": 0 },
                "1": { "text": "Primary", "color": "green", "index": 1 }
              }
            }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Unsynced nodes",
      "description": "Nodes whose local state isn't 'synced' (3). During an SST this is expected and temporary.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(mariadb_galera_local_state{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"} != 3) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Node local state",
      "description": "0=joining, 1=donor/desynced, 2=joined, 3=synced. Only 'synced' fully participates in replication.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_local_state{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3,
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 10 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "joining", "color": "orange", "index": 0 },
                "1": { "text": "donor/desynced", "color": "yellow", "index": 1 },
                "2": { "text": "joined", "color": "blue", "index": 2 },
                "3": { "text": "synced", "color": "green", "index": 3 }
              }
            }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Cluster size over time",
      "description": "Changes here are membership events: a node joining, leaving, or a network partition.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_cluster_size{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{cluster_name}} / {{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineInterpolation": "stepAfter" }, "min": 0 }
      }
    },
    {
      "id": 7,
      "title": "Flow control — fraction of time paused",
      "description": "When a node can't keep up, Galera pauses replication for the whole cluster. A sustained value above 0 indicates a slow node throttling everyone.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_flow_control_paused{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Replication queues (average)",
      "description": "High recv_queue = the node receives more than it can apply (slow node). High send_queue = network bottleneck or slow downstream nodes.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_recv_queue_avg{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}} recv",
          "refId": "A"
        },
        {
          "expr": "mariadb_galera_send_queue_avg{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "legendFormat": "{{service_name}} send",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 } }
    },
    {
      "id": 9,
      "title": "Consolidated view by node",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "mariadb_galera_cluster_size{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "format": "table",
          "instant": true,
          "refId": "SIZE"
        },
        {
          "expr": "mariadb_galera_cluster_status{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "format": "table",
          "instant": true,
          "refId": "STATUS"
        },
        {
          "expr": "mariadb_galera_local_state{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "format": "table",
          "instant": true,
          "refId": "STATE"
        },
        {
          "expr": "mariadb_galera_flow_control_paused{cluster_name=~\"$cluster_name\", service_name=~\"$service_name\"}",
          "format": "table",
          "instant": true,
          "refId": "FC"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "Value #SIZE": "Nodes in cluster",
              "Value #STATUS": "Component",
              "Value #STATE": "Local state",
              "Value #FC": "Flow control paused"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Component" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "non-Primary", "color": "red", "index": 0 }, "1": { "text": "Primary", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Local state" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "joining", "color": "orange", "index": 0 },
                      "1": { "text": "donor/desynced", "color": "yellow", "index": 1 },
                      "2": { "text": "joined", "color": "blue", "index": 2 },
                      "3": { "text": "synced", "color": "green", "index": 3 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    }
  ]
}
