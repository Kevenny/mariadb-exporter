# /etc/mariadb_exporter/mariadb_exporter.env
#
# Recommended permissions (the file contains the monitoring password):
#   chown root:mariadb_exporter /etc/mariadb_exporter/mariadb_exporter.env
#   chmod 640 /etc/mariadb_exporter/mariadb_exporter.env

MARIADB_DSN=mariadb://mariadb_exporter:strong_password@tcp(localhost:3306)/

# Optional — uncomment as needed.
#MARIADB_WEB_LISTEN_ADDRESS=:9104
#MARIADB_WEB_TELEMETRY_PATH=/metrics
#MARIADB_LOG_LEVEL=info
#MARIADB_LOG_FORMAT=text
#MARIADB_DATASOURCE_MAX_OPEN=3
#MARIADB_DATASOURCE_MAX_IDLE=3
#MARIADB_DATASOURCE_TIMEOUT=30s
