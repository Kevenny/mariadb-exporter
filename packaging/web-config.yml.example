# web-config.yml — TLS e/ou autenticação para os endpoints do mariadb_exporter.
#
# Habilite com:
#   mariadb_exporter --web.config.file=/etc/mariadb_exporter/web-config.yml
#
# Sem esta flag, o exporter serve HTTP simples sem autenticação (comportamento
# padrão de exporters Prometheus). Este arquivo é processado pelo
# exporter-toolkit da Prometheus; a referência completa está em:
# https://github.com/prometheus/exporter-toolkit/blob/master/docs/web-configuration.md
#
# O arquivo contém hashes de senha e o caminho da chave privada — proteja-o:
#   chown root:mariadb_exporter /etc/mariadb_exporter/web-config.yml
#   chmod 640 /etc/mariadb_exporter/web-config.yml

# ---------------------------------------------------------------------------
# Basic auth
# ---------------------------------------------------------------------------
# As senhas são armazenadas como hash bcrypt, nunca em texto claro. Gere um
# hash com o htpasswd do Apache:
#
#   htpasswd -nBC 10 "" | tr -d ':\n'
#
# (o comando pede a senha e imprime só o hash; o prefixo é $2y$ ou $2a$)
#
# O hash abaixo corresponde à senha "senha_do_prometheus" — TROQUE antes de usar.
#
# ATENÇÃO: o basic auth se aplica a TODOS os endpoints, inclusive /health. Não é
# possível excluir um path. Se você usa /health como health check de load
# balancer, Kubernetes probe ou healthcheck do Docker, configure a sonda para
# enviar a credencial — por exemplo, no Docker:
#
#   healthcheck:
#     test: ["CMD", "curl", "-fsk", "-u", "prometheus:SENHA", "https://localhost:9104/health"]
#
# Ou deixe a autenticação de fora e proteja o exporter por rede (bind em
# 127.0.0.1 + firewall), que é o padrão de exporters Prometheus.
basic_auth_users:
  prometheus: $2a$10$YlKXKGr6Zy0o67vkjDv4MOLwG/2vXPCq1ZayOB55cQJqevY3fbfRu

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Descomente o bloco para servir HTTPS. Lembre-se de ajustar o scheme no lado
# de quem faz o scrape:
#   - Prometheus: `scheme: https` no scrape_config
#   - PMM:        `--scheme=https` no `pmm-admin add external`
#
# Se o certificado for autoassinado, o coletor precisa confiar na CA
# (`ca_file` no Prometheus) ou desabilitar a verificação
# (`insecure_skip_verify: true` — evite em produção).
#
#tls_server_config:
#  cert_file: /etc/mariadb_exporter/tls/exporter.crt
#  key_file:  /etc/mariadb_exporter/tls/exporter.key
#
#  # Versão mínima do TLS. TLS12 é o piso recomendado; use TLS13 se todos os
#  # clientes suportarem.
#  min_version: TLS12
#
#  # mTLS: exige que o cliente (Prometheus/pmm-agent) apresente um certificado
#  # assinado pela CA informada. É a proteção mais forte, e dispensa basic auth.
#  #client_auth_type: RequireAndVerifyClientCert
#  #client_ca_file: /etc/mariadb_exporter/tls/ca.crt

# ---------------------------------------------------------------------------
# Exemplo de scrape_config do Prometheus para este exporter com TLS + auth
# ---------------------------------------------------------------------------
# scrape_configs:
#   - job_name: 'mariadb'
#     scheme: https
#     basic_auth:
#       username: prometheus
#       password: senha_do_prometheus
#     tls_config:
#       ca_file: /etc/prometheus/tls/ca.crt
#     static_configs:
#       - targets: ['mariadb-host01:9104']
