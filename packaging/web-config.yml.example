# web-config.yml — TLS and/or authentication for mariadb_exporter's endpoints.
#
# Enable with:
#   mariadb_exporter --web.config.file=/etc/mariadb_exporter/web-config.yml
#
# Without this flag, the exporter serves plain HTTP with no authentication
# (the standard behavior for Prometheus exporters). This file is processed by
# the Prometheus exporter-toolkit; the full reference is at:
# https://github.com/prometheus/exporter-toolkit/blob/master/docs/web-configuration.md
#
# The file contains password hashes and the private key path — protect it:
#   chown root:mariadb_exporter /etc/mariadb_exporter/web-config.yml
#   chmod 640 /etc/mariadb_exporter/web-config.yml

# ---------------------------------------------------------------------------
# Basic auth
# ---------------------------------------------------------------------------
# Passwords are stored as bcrypt hashes, never in plaintext. Generate a hash
# with Apache's htpasswd:
#
#   htpasswd -nBC 10 "" | tr -d ':\n'
#
# (the command prompts for the password and prints only the hash; the prefix
# is $2y$ or $2a$)
#
# The hash below corresponds to the password "senha_do_prometheus" — CHANGE it
# before use.
#
# WARNING: basic auth applies to ALL endpoints, including /health. There is no
# way to exclude a path. If you use /health as a load balancer health check,
# Kubernetes probe, or Docker healthcheck, configure the probe to send the
# credential — for example, in Docker:
#
#   healthcheck:
#     test: ["CMD", "curl", "-fsk", "-u", "prometheus:PASSWORD", "https://localhost:9104/health"]
#
# Or leave authentication out and protect the exporter at the network level
# (bind to 127.0.0.1 + firewall), which is the standard for Prometheus
# exporters.
basic_auth_users:
  prometheus: $2a$10$YlKXKGr6Zy0o67vkjDv4MOLwG/2vXPCq1ZayOB55cQJqevY3fbfRu

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Uncomment the block to serve HTTPS. Remember to adjust the scheme on
# whoever does the scrape:
#   - Prometheus: `scheme: https` in the scrape_config
#   - PMM:        `--scheme=https` in `pmm-admin add external`
#
# If the certificate is self-signed, the scraper needs to trust the CA
# (`ca_file` in Prometheus) or disable verification
# (`insecure_skip_verify: true` — avoid in production).
#
#tls_server_config:
#  cert_file: /etc/mariadb_exporter/tls/exporter.crt
#  key_file:  /etc/mariadb_exporter/tls/exporter.key
#
#  # Minimum TLS version. TLS12 is the recommended floor; use TLS13 if all
#  # clients support it.
#  min_version: TLS12
#
#  # mTLS: requires the client (Prometheus/pmm-agent) to present a certificate
#  # signed by the given CA. This is the strongest protection, and makes basic
#  # auth unnecessary.
#  #client_auth_type: RequireAndVerifyClientCert
#  #client_ca_file: /etc/mariadb_exporter/tls/ca.crt

# ---------------------------------------------------------------------------
# Example Prometheus scrape_config for this exporter with TLS + auth
# ---------------------------------------------------------------------------
# scrape_configs:
#   - job_name: 'mariadb'
#     scheme: https
#     basic_auth:
#       username: prometheus
#       password: senha_do_prometheus
#     tls_config:
#       ca_file: /etc/prometheus/tls/ca.crt
#     static_configs:
#       - targets: ['mariadb-host01:9104']
